# Database
DATABASE_URL=postgresql://user:password@localhost:5432/pandoroom?schema=public

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# CORS
CORS_ORIGINS=https://pandoroom.e-rma.ru,https://pandoroom-admin.e-rma.ru

# S3 Storage (optional - if not set, local storage will be used)
S3_ENABLED=false
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=pandoroom
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# Server
PORT=3001
NODE_ENV=production

# Notifications
TELEGRAM_BOT_TOKEN=
SMS_PROVIDER=stub
SMS_API_KEY=
MAX_BOT_TOKEN=

# Google Calendar
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CALENDAR_ID=primary
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./google-service-account.json

# Ключи интеграций заводятся в админке (Настройки → Интеграции).
# Переменные ниже — запасной источник: используются, пока поле в админке пустое.

# TBank Payments
TBANK_TERMINAL_KEY=
TBANK_PASSWORD=
TBANK_API_URL=https://securepay.tinkoff.ru/v2
# Тот же адрес нужно указать в кабинете Т-Банка как источник HTTP-уведомлений
PAYMENT_WEBHOOK_URL=https://pandoroom-back.e-rma.ru/api/payments/webhook
PAYMENT_SUCCESS_URL=https://pandoroom.e-rma.ru/payment/success
PAYMENT_FAIL_URL=https://pandoroom.e-rma.ru/payment/fail

# Zvonok — код входа в личный кабинет (звонок или СМС)
ZVONOK_PUBLIC_KEY=
ZVONOK_API_V2_KEY=
ZVONOK_CALL_CAMPAIGN_ID=
ZVONOK_SMS_CAMPAIGN_ID=

# iiko Integration
IIKO_WEBHOOK_SECRET=
IIKO_API_URL=https://api-ru.iiko.services
IIKO_API_LOGIN=
# appId и clientSecret из портала разработчика iiko (https://public-api.iikoweb.ru/portal)
IIKO_APP_ID=
IIKO_CLIENT_SECRET=
IIKO_ORGANIZATION_ID=
